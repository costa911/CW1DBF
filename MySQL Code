-- Creating the Database, and it's Tables

CREATE DATABASE SteppingIntoHistory;

USE SteppingIntoHistory;

-- Customer Table
CREATE TABLE Customer (
    CustomerID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(255) NOT NULL,
    Email VARCHAR(255) UNIQUE NOT NULL,
    Phone VARCHAR(15) NOT NULL,
    Address VARCHAR(255)
);

-- Order Table
CREATE TABLE `Order` (
    OrderID INT AUTO_INCREMENT PRIMARY KEY,
    OrderDate DATE NOT NULL,
    TotalAmount DECIMAL(10, 2) NOT NULL CHECK (TotalAmount > 0),
    CustomerID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)
);

-- PaymentType Table
CREATE TABLE PaymentType (
    PaymentTypeID INT AUTO_INCREMENT PRIMARY KEY,
    TypeName VARCHAR(255) UNIQUE NOT NULL
);

-- Payment Table
CREATE TABLE Payment (
    PaymentID INT AUTO_INCREMENT PRIMARY KEY,
    PaymentDate DATE NOT NULL,
    OrderID INT NOT NULL,
    PaymentTypeID INT NOT NULL,
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (PaymentTypeID) REFERENCES PaymentType(PaymentTypeID)
);

-- BookFormat Table
CREATE TABLE BookFormat (
    BookFormatID INT AUTO_INCREMENT PRIMARY KEY,
    FormatName VARCHAR(255) UNIQUE NOT NULL
);

-- Book Table
CREATE TABLE Book (
    BookID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(255) NOT NULL,
    Author VARCHAR(255) NOT NULL,
    YearPublished YEAR NOT NULL,
    BookFormatID INT NOT NULL,
    FOREIGN KEY (BookFormatID) REFERENCES BookFormat(BookFormatID)
);

-- Book Orders
CREATE TABLE Order_Book (
    OrderBookID INT AUTO_INCREMENT PRIMARY KEY,
    OrderID INT NOT NULL,
    BookID INT NOT NULL,
    Quantity INT NOT NULL DEFAULT 1,  -- To track how many copies of this book are ordered
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (BookID) REFERENCES Book(BookID),
    UNIQUE (OrderID, BookID)  -- Ensures that each book can only appear once per order
);

-- Workshop Table
CREATE TABLE Workshop (
    WorkshopID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(255) NOT NULL,
    Date DATE NOT NULL,
    HistorianID INT NOT NULL,
    FOREIGN KEY (HistorianID) REFERENCES Historian(HistorianID)
);

-- Workshop Order
CREATE TABLE Order_Workshop (
    OrderWorkshopID INT AUTO_INCREMENT PRIMARY KEY,
    OrderID INT NOT NULL,
    WorkshopID INT NOT NULL,
    Quantity INT NOT NULL DEFAULT 1,
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (WorkshopID) REFERENCES Workshop(WorkshopID),
    UNIQUE (OrderID, WorkshopID)
);

-- Historian Table
CREATE TABLE Historian (
    HistorianID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(255) NOT NULL,
    AreaOfExpertiseID INT NOT NULL,
    FOREIGN KEY (AreaOfExpertiseID) REFERENCES HistorianAreaOfExpertise(AreaOfExpertiseID)
);

-- HistorianAreaOfExpertise Table
CREATE TABLE HistorianAreaOfExpertise (
    AreaOfExpertiseID INT AUTO_INCREMENT PRIMARY KEY,
    ExpertiseName VARCHAR(255) UNIQUE NOT NULL
);

-- Tour Table
CREATE TABLE Tour (
    TourID INT AUTO_INCREMENT PRIMARY KEY,
    TourName VARCHAR(255) NOT NULL,
    HistorianID INT NOT NULL,
    HistoricSiteID INT NOT NULL,
    Date DATE NOT NULL,
    FOREIGN KEY (HistorianID) REFERENCES Historian(HistorianID),
    FOREIGN KEY (HistoricSiteID) REFERENCES HistoricSite(SiteID)
);

-- Tour Order
CREATE TABLE Order_Tour (
    OrderTourID INT AUTO_INCREMENT PRIMARY KEY,
    OrderID INT NOT NULL,
    TourID INT NOT NULL,
    Quantity INT NOT NULL DEFAULT 1,
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (TourID) REFERENCES Tour(TourID),
    UNIQUE (OrderID, TourID)
);

-- HistoricSite Table
CREATE TABLE HistoricSite (
    SiteID INT AUTO_INCREMENT PRIMARY KEY,
    SiteName VARCHAR(255) UNIQUE NOT NULL,
    Location VARCHAR(255) NOT NULL
);

-- MagazineSubscriptionType Table
CREATE TABLE MagazineSubscriptionType (
    SubscriptionTypeID INT AUTO_INCREMENT PRIMARY KEY,
    TypeName VARCHAR(255) UNIQUE NOT NULL
);
-- MagazineSubscription Table
CREATE TABLE MagazineSubscription (
    SubscriptionID INT AUTO_INCREMENT PRIMARY KEY,
    SubscriptionDate DATE NOT NULL,
    CustomerID INT NOT NULL,
    SubscriptionTypeID INT NOT NULL, 
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (SubscriptionTypeID) REFERENCES MagazineSubscriptionType(SubscriptionTypeID)
);

-- MagazineSubscriptions Orders
CREATE TABLE Order_MagazineSubscription (
    OrderMagazineSubscriptionID INT AUTO_INCREMENT PRIMARY KEY,
    OrderID INT NOT NULL,
    SubscriptionID INT NOT NULL,
    Quantity INT NOT NULL DEFAULT 1,  -- To track how many subscriptions of this type are ordered
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (SubscriptionID) REFERENCES MagazineSubscription(SubscriptionID),
    UNIQUE (OrderID, SubscriptionID)  -- Ensures that each subscription can only appear once per order
);

-- GenealogicalResearch Table
CREATE TABLE GenealogicalResearch (
    ResearchID INT AUTO_INCREMENT PRIMARY KEY,
    ResearchDetails TEXT NOT NULL,
    CustomerID INT NOT NULL,
    ResearcherID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (ResearcherID) REFERENCES Researcher(ResearcherID)
);

-- Genealogical Order 
CREATE TABLE Order_GenealogicalResearch (
    OrderResearchID INT AUTO_INCREMENT PRIMARY KEY,
    OrderID INT NOT NULL,
    ResearchID INT NOT NULL,
    Quantity INT NOT NULL DEFAULT 1, -- To track how many research requests are associated with this order
    FOREIGN KEY (OrderID) REFERENCES `Order`(OrderID),
    FOREIGN KEY (ResearchID) REFERENCES GenealogicalResearch(ResearchID),
    UNIQUE (OrderID, ResearchID) -- Ensures that each research request can only appear once per order
);

-- Researcher Table
CREATE TABLE Researcher (
    ResearcherID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(255) NOT NULL,
    Specialty VARCHAR(255) NOT NULL
);

-- Feedback Tables
-- WorkshopFeedback
CREATE TABLE WorkshopFeedback (
    FeedbackID INT AUTO_INCREMENT PRIMARY KEY,
    Rating INT NOT NULL CHECK (Rating BETWEEN 1 AND 5),
    Comments TEXT,
    FeedbackDate DATE NOT NULL,
    CustomerID INT NOT NULL,
    WorkshopID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (WorkshopID) REFERENCES Workshop(WorkshopID)
);

-- Tour Feedback
CREATE TABLE TourFeedback (
    FeedbackID INT AUTO_INCREMENT PRIMARY KEY,
    Rating INT NOT NULL CHECK (Rating BETWEEN 1 AND 5),
    Comments TEXT,
    FeedbackDate DATE NOT NULL,
    CustomerID INT NOT NULL,
    TourID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (TourID) REFERENCES Tour(TourID)
);

-- ResearchFeedback
CREATE TABLE ResearchFeedback (
    FeedbackID INT AUTO_INCREMENT PRIMARY KEY,
    Rating INT NOT NULL CHECK (Rating BETWEEN 1 AND 5),
    Comments TEXT,
    FeedbackDate DATE NOT NULL,
    CustomerID INT NOT NULL,
    ResearchID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (ResearchID) REFERENCES GenealogicalResearch(ResearchID)
);


-- Attendance Tables 
-- Workshop Attendance
CREATE TABLE WorkshopAttendance (
    AttendanceID INT AUTO_INCREMENT PRIMARY KEY,
    CustomerID INT NOT NULL,
    WorkshopID INT NOT NULL,
    AttendanceDate DATE NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (WorkshopID) REFERENCES Workshop(WorkshopID)
);

-- Tour Attendance
CREATE TABLE TourAttendance (
    AttendanceID INT AUTO_INCREMENT PRIMARY KEY,
    CustomerID INT NOT NULL,
    TourID INT NOT NULL,
    AttendanceDate DATE NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID),
    FOREIGN KEY (TourID) REFERENCES Tour(TourID)
);

